{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/external-source.schema.json",
  "title": "ExternalSourceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "homepage",
    "repository",
    "license",
    "trustTier",
    "status",
    "marketplace",
    "marketplaceSource",
    "version",
    "permissions",
    "requiredDependencies",
    "updatePolicy",
    "reviewedAt"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/kebabCaseId" },
    "name": { "$ref": "#/$defs/localizedText" },
    "homepage": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "trustTier": { "$ref": "#/$defs/trustTier" },
    "status": { "$ref": "#/$defs/releaseStatus" },
    "marketplace": { "$ref": "#/$defs/safeMarketplace" },
    "marketplaceSource": { "$ref": "#/$defs/safeMarketplaceSource" },
    "version": { "$ref": "#/$defs/semver" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "requiredDependencies": { "$ref": "#/$defs/dependencyArray" },
    "updatePolicy": { "type": "string", "minLength": 1 },
    "reviewedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "$defs": {
    "kebabCaseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "trustTier": {
      "type": "string",
      "enum": ["verified", "trusted", "community", "blocked"]
    },
    "pluginDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reason"],
      "properties": {
        "name": { "$ref": "#/$defs/kebabCaseId" },
        "marketplace": { "$ref": "#/$defs/safeMarketplace" },
        "version": { "type": "string", "minLength": 1 },
        "reason": { "$ref": "#/$defs/localizedText" }
      }
    },
    "dependencyArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/pluginDependency" }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "commands", "network", "externalData"],
      "properties": {
        "filesystem": { "$ref": "#/$defs/stringArray" },
        "commands": { "$ref": "#/$defs/stringArray" },
        "network": { "$ref": "#/$defs/stringArray" },
        "externalData": { "$ref": "#/$defs/stringArray" }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "safeMarketplace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "safeMarketplaceSource": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*\\/[A-Za-z0-9][A-Za-z0-9._-]*|https:\\/\\/[A-Za-z0-9.-]+(?:\\/[A-Za-z0-9._~%\\/-]+)*)$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "releaseStatus": {
      "type": "string",
      "enum": ["draft", "beta", "stable", "deprecated", "blocked"]
    }
  }
}
