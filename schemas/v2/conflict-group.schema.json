{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/conflict-group.schema.json", "title": "ConflictGroupManifest", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "capabilityId", "runtime", "platform", "mode", "providerIds", "rationale"],
  "properties": { "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "capabilityId": { "$ref": "#/$defs/id" }, "runtime": { "enum": ["claude-code", "codex"] }, "platform": { "enum": ["darwin", "linux", "win32"] }, "mode": { "enum": ["mutually-exclusive", "redundant", "composable"] }, "providerIds": { "$ref": "#/$defs/idArray" }, "rationale": { "$ref": "#/$defs/localizedText" } },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "idArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "localizedText": { "type": "object", "additionalProperties": false, "required": ["ko", "en"], "properties": { "ko": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } } } }
}
