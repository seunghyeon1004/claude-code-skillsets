{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/lifecycle-state.schema.json",
  "title": "LifecycleState",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogFingerprint", "goalSummarySha256", "domainIds", "level", "packIds", "providerIds", "marketplaceIdentities", "platform", "claudeVersion", "approvedPlanFingerprint", "operations", "receipts", "ownership"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "catalogFingerprint": { "$ref": "#/$defs/sha256" },
    "goalSummarySha256": { "$ref": "#/$defs/sha256" },
    "domainIds": { "$ref": "#/$defs/nonEmptyDomainIdArray" },
    "level": { "enum": ["essential", "recommended", "domain-full", "advanced", "full-catalog"] },
    "packIds": { "$ref": "#/$defs/packIdArray" },
    "providerIds": { "$ref": "#/$defs/idArray" },
    "marketplaceIdentities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/marketplaceIdentity" } },
    "platform": { "$ref": "#/$defs/platform" },
    "claudeVersion": { "$ref": "#/$defs/semver" },
    "approvedPlanFingerprint": { "$ref": "#/$defs/sha256" },
    "operations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/approvedOperation" } },
    "receipts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/operationReceipt" } },
    "ownership": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ownershipRecord" } },
    "resumeCursor": { "$ref": "#/$defs/kebabCaseId" }
  },
  "allOf": [
    {
      "if": { "properties": { "platform": { "const": "darwin" } } },
      "then": { "properties": { "operations": { "type": "array", "items": { "type": "object", "properties": { "platform": { "const": "darwin" } } } } } }
    },
    {
      "if": { "properties": { "platform": { "const": "linux" } } },
      "then": { "properties": { "operations": { "type": "array", "items": { "type": "object", "properties": { "platform": { "const": "linux" } } } } } }
    },
    {
      "if": { "properties": { "platform": { "const": "win32" } } },
      "then": { "properties": { "operations": { "type": "array", "items": { "type": "object", "properties": { "platform": { "const": "win32" } } } } } }
    }
  ],
  "$defs": {
    "kebabCaseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "idArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/kebabCaseId" } },
    "packIdArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/packId" } },
    "nonEmptyDomainIdArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/domainId" } },
    "platform": { "enum": ["darwin", "linux", "win32"] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$" },
    "marketplaceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabCaseId" },
        "source": { "$ref": "#/$defs/sourceIdentity" }
      }
    },
    "approvedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "platform", "commandId", "approvedPlanFingerprint"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabCaseId" },
        "kind": { "enum": ["probe", "marketplace-add", "verify-marketplace", "install", "verify-provider", "state-write", "update", "uninstall", "marketplace-remove"] },
        "platform": { "$ref": "#/$defs/platform" },
        "providerId": { "$ref": "#/$defs/kebabCaseId" },
        "commandId": { "$ref": "#/$defs/kebabCaseId" },
        "approvedPlanFingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "operationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "status", "resultCode"],
      "properties": {
        "operationId": { "$ref": "#/$defs/kebabCaseId" },
        "status": { "enum": ["succeeded", "failed", "skipped"] },
        "resultCode": { "$ref": "#/$defs/kebabCaseId" }
      }
    },
    "ownershipRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packIds", "managed"],
      "properties": {
        "pluginId": { "$ref": "#/$defs/kebabCaseId" },
        "packIds": { "$ref": "#/$defs/packIdArray" },
        "managed": { "type": "boolean" }
      }
    },
    "sourceIdentity": { "anyOf": [{ "$ref": "#/$defs/ownerRepository" }, { "$ref": "#/$defs/httpsSourceIdentity" }] },
    "ownerRepository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "httpsSourceIdentity": { "type": "string", "pattern": "^https://(?!(?:localhost|127(?:\\.[0-9]{1,3}){3}|10(?:\\.[0-9]{1,3}){3}|192\\.168(?:\\.[0-9]{1,3}){2}|172\\.(?:1[6-9]|2[0-9]|3[0-1])(?:\\.[0-9]{1,3}){2})(?::|/|$))[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]+)?(?:/[A-Za-z0-9._~!$&'()*+,;=:%@/-]*)?$" },
    "domainId": { "enum": ["research-and-intelligence", "strategy-and-decision", "writing-and-publishing", "marketing-and-growth", "promotion-and-distribution", "sales-and-customer", "product-management", "project-management", "software-engineering", "devops-and-security", "ai-agents-and-automation", "data-and-analytics", "design-and-brand", "video-and-audio", "documents-and-knowledge", "business-operations", "finance-and-accounting", "commerce", "people-and-training", "legal-risk-and-compliance"] },
    "packId": { "enum": ["question-to-cited-research-brief", "competitor-landscape-to-opportunity-map", "customer-interviews-to-insights", "evidence-to-strategic-decision", "idea-to-edited-article", "source-to-multilingual-publication", "product-to-positioning-and-offer", "keyword-to-ranked-content", "launch-plan-to-multichannel-campaign", "long-form-to-social-distribution", "account-research-to-personalized-outreach", "discovery-call-to-proposal", "customer-problem-to-validated-prd", "prd-to-prioritized-roadmap", "project-brief-to-execution-board", "repository-to-implementation-plan", "spec-to-tested-feature", "bug-report-to-verified-fix", "service-to-ci-cd-deployment", "incident-alert-to-postmortem", "application-to-security-review", "use-case-to-agent-design", "prototype-to-evaluated-agent", "raw-data-to-validated-dataset", "business-question-to-dashboard", "brief-to-accessible-interface", "brand-strategy-to-visual-system", "topic-to-recording-ready-script", "raw-footage-to-published-video", "long-video-to-multiplatform-clips", "meeting-to-decisions-and-actions", "source-files-to-polished-document", "manual-process-to-maintained-sop", "repetitive-work-to-approved-automation", "transactions-to-management-report", "product-idea-to-store-listing", "role-need-to-interview-scorecard", "expertise-to-training-program", "contract-to-risk-and-revision-brief", "regulation-to-compliance-checklist"] }
  }
}
