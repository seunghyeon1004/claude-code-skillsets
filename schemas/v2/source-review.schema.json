{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/source-review.schema.json", "title": "SourceReviewManifest", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "providerId", "candidateId", "searchRecordIds", "snapshotIds", "discoveryTier", "originalRepository", "selectedPaths", "reviewedCommit", "reviewedAt", "marketplaceIdentity", "observedVersion", "licenseConclusion", "lastMeaningfulChange", "surfaces", "permissions", "secretFlows", "compatibility", "linkedDomainIds", "linkedCategoryIds", "linkedPackIds", "capabilityIds", "removalStrategy", "evidenceIds", "capabilityTargetReviews", "updatePolicy", "nextReviewDate"],
  "properties": { "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "providerId": { "$ref": "#/$defs/id" }, "candidateId": { "$ref": "#/$defs/id" }, "searchRecordIds": { "$ref": "#/$defs/idArray" }, "snapshotIds": { "$ref": "#/$defs/idArray" }, "supersedesReviewId": { "$ref": "#/$defs/id" }, "discoveryTier": { "enum": ["A", "B", "C", "D"] }, "originalRepository": { "$ref": "#/$defs/httpsRepository" }, "selectedPaths": { "$ref": "#/$defs/pathArray" }, "reviewedCommit": { "$ref": "#/$defs/sha1" }, "reviewedAt": { "$ref": "#/$defs/dateTime" }, "marketplaceIdentity": { "oneOf": [{ "$ref": "#/$defs/marketplace" }, { "type": "null" }] }, "observedVersion": { "oneOf": [{ "$ref": "#/$defs/semver" }, { "type": "null" }] }, "licenseConclusion": { "type": "string", "minLength": 1 }, "lastMeaningfulChange": { "type": "string", "format": "date" }, "surfaces": { "$ref": "#/$defs/surfaces" }, "permissions": { "$ref": "#/$defs/permissions" }, "secretFlows": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/secretFlow" } }, "compatibility": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/compatibility" } }, "linkedDomainIds": { "$ref": "#/$defs/idArray" }, "linkedCategoryIds": { "$ref": "#/$defs/idArray" }, "linkedPackIds": { "$ref": "#/$defs/idArray" }, "capabilityIds": { "$ref": "#/$defs/idArray" }, "removalStrategy": { "type": "string", "minLength": 1 }, "evidenceIds": { "$ref": "#/$defs/idArray" }, "capabilityTargetReviews": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/targetReview" } }, "updatePolicy": { "type": "string", "minLength": 1 }, "nextReviewDate": { "type": "string", "format": "date" } },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }, "dateTime": { "type": "string", "format": "date-time" }, "httpsRepository": { "type": "string", "pattern": "^https://[^/@?#:]+(?:\\.[^/@?#:]+)+(?:/[^?#]*)?$" }, "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.?(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000-\\u001f])[A-Za-z0-9._/-]+$" }, "idArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "pathArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }, "stringArray": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "permissions": { "type": "object", "additionalProperties": false, "required": ["filesystem", "commands", "network", "externalData"], "properties": { "filesystem": { "$ref": "#/$defs/stringArray" }, "commands": { "$ref": "#/$defs/stringArray" }, "network": { "$ref": "#/$defs/stringArray" }, "externalData": { "$ref": "#/$defs/stringArray" } } }, "marketplace": { "type": "object", "additionalProperties": false, "required": ["id", "source"], "properties": { "id": { "$ref": "#/$defs/id" }, "source": { "$ref": "#/$defs/httpsRepository" } } }, "secretFlow": { "type": "object", "additionalProperties": false, "required": ["name", "documentedIntegrationFlow"], "properties": { "name": { "type": "string", "minLength": 1 }, "documentedIntegrationFlow": { "type": "boolean" } } }, "surfaces": { "type": "object", "additionalProperties": false, "required": ["skills", "commands", "agents", "hooks", "mcpServers", "scripts", "binaries"], "properties": { "skills": { "$ref": "#/$defs/stringArray" }, "commands": { "$ref": "#/$defs/stringArray" }, "agents": { "$ref": "#/$defs/stringArray" }, "hooks": { "$ref": "#/$defs/stringArray" }, "mcpServers": { "$ref": "#/$defs/stringArray" }, "scripts": { "$ref": "#/$defs/stringArray" }, "binaries": { "$ref": "#/$defs/stringArray" } } },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["runtime", "runtimeVersionRange", "platforms"], "properties": { "runtime": { "enum": ["claude-code", "codex"] }, "runtimeVersionRange": { "type": "string", "minLength": 1 }, "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["darwin", "linux", "win32"] } } } }, "hardGate": { "type": "object", "additionalProperties": false, "required": ["id", "passed", "evidenceRefs"], "properties": { "id": { "enum": ["bounded-permissions", "compatible-runtime-and-platforms", "documented-secret-flow", "immutable-reviewed-revision", "install-and-semantic-smoke", "lifecycle-strategy", "marketplace-identity-consistent", "original-repository-identified", "outcome-value-demonstrated", "selected-path-license-usable", "transparent-bootstrap-and-surfaces"] }, "passed": { "type": "boolean" }, "evidenceRefs": { "$ref": "#/$defs/idArray" } } }, "scoreCriterion": { "type": "object", "additionalProperties": false, "required": ["id", "evidenceRefs"], "properties": { "id": { "type": "string", "minLength": 1 }, "evidenceRefs": { "$ref": "#/$defs/idArray" } } }, "score": { "type": "object", "additionalProperties": false, "required": ["outcomeFitAndDepth", "securityAndTransparency", "maintenanceAndUpdateability", "nativeInstallability", "documentationAndEvaluation"], "properties": { "outcomeFitAndDepth": { "type": "number", "minimum": 0 }, "securityAndTransparency": { "type": "number", "minimum": 0 }, "maintenanceAndUpdateability": { "type": "number", "minimum": 0 }, "nativeInstallability": { "type": "number", "minimum": 0 }, "documentationAndEvaluation": { "type": "number", "minimum": 0 } } },
    "targetReview": { "type": "object", "additionalProperties": false, "required": ["runtime", "platform", "capabilityId", "decision", "assuranceProfiles", "hardGates", "evidenceIds", "scoreCriteria", "score", "decisionReasons"], "properties": { "runtime": { "enum": ["claude-code", "codex"] }, "platform": { "enum": ["darwin", "linux", "win32"] }, "capabilityId": { "$ref": "#/$defs/id" }, "decision": { "enum": ["eligible", "rejected", "revoked"] }, "assuranceProfiles": { "type": "array", "uniqueItems": true, "items": { "enum": ["standard", "high-impact"] } }, "hardGates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hardGate" } }, "evidenceIds": { "$ref": "#/$defs/idArray" }, "scoreCriteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/scoreCriterion" } }, "score": { "$ref": "#/$defs/score" }, "decisionReasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } }
  }
}
