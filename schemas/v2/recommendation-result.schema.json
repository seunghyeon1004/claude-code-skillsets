{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/recommendation-result.schema.json",
  "title": "StructuredRecommendation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "goalSummary", "goalSummaryProjection", "inputs", "outputs", "domainIds", "packIds", "evidence", "unresolvedQuestions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "goalSummary": { "$ref": "#/$defs/sanitizedGoalSummary" },
    "goalSummaryProjection": { "$ref": "#/$defs/goalSummaryProjection" },
    "inputs": { "$ref": "#/$defs/idArray" },
    "outputs": { "$ref": "#/$defs/idArray" },
    "domainIds": { "$ref": "#/$defs/recommendationDomainIds" },
    "packIds": { "$ref": "#/$defs/packIdArray" },
    "evidence": { "$ref": "#/$defs/modelTextArray" },
    "unresolvedQuestions": { "$ref": "#/$defs/modelTextArray" }
  },
  "$defs": {
    "kebabCaseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "safeKebabCaseId": {
      "type": "string",
      "allOf": [
        { "$ref": "#/$defs/kebabCaseId" },
        { "not": { "pattern": "^(?:approved|approval|consent|consented|authorized|authorised|permission-granted|allowed|rm(?:-[a-z0-9]+)+|(?:github|gitlab|bitbucket)(?:-[a-z0-9]+)*)$" } }
      ]
    },
    "idArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/safeKebabCaseId" } },
    "modelTextArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/safeModelText" } },
    "safeModelText": {
      "$comment": "Plain-language projection only. Any slash-bearing token is intentionally rejected as a conservative path/source boundary; executable command syntax and affirmative approval claims are rejected while descriptive prose and questions remain valid.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        { "not": { "pattern": "[\\u0000-\\u001F\\u007F]" } },
        { "not": { "pattern": "(?:^|[\\s;|&])(?:[Rr][Mm]|[Cc][Uu][Rr][Ll]|[Ww][Gg][Ee][Tt]|[Ss][Uu][Dd][Oo]|[Cc][Hh][Mm][Oo][Dd]|[Cc][Hh][Oo][Ww][Nn]|[Bb][Aa][Ss][Hh]|[Zz][Ss][Hh]|[Pp][Oo][Ww][Ee][Rr][Ss][Hh][Ee][Ll][Ll]|[Cc][Mm][Dd])\\s+(?:--?[A-Za-z0-9]|[./~$]|[A-Za-z]:[\\\\/])" } },
        { "not": { "pattern": "(?:^|[\\s;|&])(?:[Bb][Aa][Ss][Hh]|[Zz][Ss][Hh]|[Pp][Oo][Ww][Ee][Rr][Ss][Hh][Ee][Ll][Ll]|[Cc][Mm][Dd])\\s+[A-Za-z0-9_.-]+\\.(?:[Ss][Hh]|[Bb][Aa][Ss][Hh]|[Zz][Ss][Hh]|[Pp][Ss]1|[Bb][Aa][Tt]|[Cc][Mm][Dd])\\b" } },
        { "not": { "pattern": "/" } },
        { "not": { "pattern": "(?:^|[\\s\\x22'`(])[A-Za-z]:[\\\\/](?:[^\\s]+)?" } },
        { "not": { "pattern": "[Hh][Tt][Tt][Pp][Ss]?://|[Gg][Ii][Tt](?:\\+ssh)?://|[Ww][Ww][Ww]\\." } },
        { "not": { "pattern": "(?:[Gg][Ii][Tt][Hh][Uu][Bb]|[Gg][Ii][Tt][Ll][Aa][Bb]|[Bb][Ii][Tt][Bb][Uu][Cc][Kk][Ee][Tt])\\.com|(?:[Gg][Ii][Tt][Hh][Uu][Bb]|[Gg][Ii][Tt][Ll][Aa][Bb]|[Bb][Ii][Tt][Bb][Uu][Cc][Kk][Ee][Tt])\\s*(?::|/)" } },
        { "not": { "pattern": "^(?![\\s\\S]*\\?)[\\s\\S]*(?:\\b[Aa]pproved\\b|\\b[Aa]uthori[Zz]ed\\s+[Bb]y\\b|\\b[Aa]llowed\\s+[Bb]y\\b|\\b[Aa]pproval\\s+(?:(?:[Hh]as|[Hh]ad)\\s+[Bb]een\\s+|(?:[Ii]s|[Ww]as)\\s+)?[Gg]ranted\\b|\\b(?:[Tt]he\\s+)?[Oo]perator\\s+(?:[Hh]as\\s+)?[Cc]onsented\\b|\\b[Cc]onsent\\s+(?:(?:[Hh]as|[Hh]ad)\\s+[Bb]een\\s+|(?:[Ii]s|[Ww]as)\\s+)?[Gg]ranted\\b|\\b[Pp]ermission(?:s)?\\s+(?:(?:[Hh]as|[Hh]ad)\\s+[Bb]een\\s+|(?:[Ii]s|[Ww]as)\\s+)?[Gg]ranted\\b|\\b[Aa]uthori[Zz]ation\\s+(?:(?:[Hh]as|[Hh]ad)\\s+[Bb]een\\s+|(?:[Ii]s|[Ww]as)\\s+)?[Gg]ranted\\b|(?:승인|동의|허가|승낙)(?:됨|되었|완료|확인|받았|하였|함))" } },
        { "not": { "pattern": "[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Bb][Ee][Aa][Rr][Ee][Rr]" } },
        { "not": { "pattern": "[Ss][Tt][Dd][Oo][Uu][Tt]|[Ss][Tt][Dd][Ee][Rr][Rr]" } }
      ]
    },
    "sanitizedGoalSummary": {
      "$comment": "Goal summaries share the reusable model-text boundary and retain the legacy home-directory checks.",
      "type": "string",
      "allOf": [
        { "$ref": "#/$defs/safeModelText" },
        { "not": { "pattern": "(?:^|[^A-Za-z])/(?:[Uu]sers|[Hh]ome)(?:/|$)" } },
        { "not": { "pattern": "(?:^|[^A-Za-z])[A-Za-z]:[\\\\/]" } }
      ]
    },
    "goalSummaryProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sanitizerVersion", "sourceSha256"],
      "properties": {
        "kind": { "const": "allowlisted-summary-v1" },
        "sanitizerVersion": { "$ref": "#/$defs/semver" },
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$" },
    "recommendationDomainIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domainId" }
    },
    "domainId": { "enum": ["research-and-intelligence", "strategy-and-decision", "writing-and-publishing", "marketing-and-growth", "promotion-and-distribution", "sales-and-customer", "product-management", "project-management", "software-engineering", "devops-and-security", "ai-agents-and-automation", "data-and-analytics", "design-and-brand", "video-and-audio", "documents-and-knowledge", "business-operations", "finance-and-accounting", "commerce", "people-and-training", "legal-risk-and-compliance"] },
    "packId": { "enum": ["question-to-cited-research-brief", "competitor-landscape-to-opportunity-map", "customer-interviews-to-insights", "evidence-to-strategic-decision", "idea-to-edited-article", "source-to-multilingual-publication", "product-to-positioning-and-offer", "keyword-to-ranked-content", "launch-plan-to-multichannel-campaign", "long-form-to-social-distribution", "account-research-to-personalized-outreach", "discovery-call-to-proposal", "customer-problem-to-validated-prd", "prd-to-prioritized-roadmap", "project-brief-to-execution-board", "repository-to-implementation-plan", "spec-to-tested-feature", "bug-report-to-verified-fix", "service-to-ci-cd-deployment", "incident-alert-to-postmortem", "application-to-security-review", "use-case-to-agent-design", "prototype-to-evaluated-agent", "raw-data-to-validated-dataset", "business-question-to-dashboard", "brief-to-accessible-interface", "brand-strategy-to-visual-system", "topic-to-recording-ready-script", "raw-footage-to-published-video", "long-video-to-multiplatform-clips", "meeting-to-decisions-and-actions", "source-files-to-polished-document", "manual-process-to-maintained-sop", "repetitive-work-to-approved-automation", "transactions-to-management-report", "product-idea-to-store-listing", "role-need-to-interview-scorecard", "expertise-to-training-program", "contract-to-risk-and-revision-brief", "regulation-to-compliance-checklist"] },
    "packIdArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/packId" } }
  }
}
