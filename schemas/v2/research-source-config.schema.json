{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/research-source-config.schema.json",
  "title": "ResearchSourceConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "repository", "queryUrls", "reportedCountClaims", "markdownIndexPaths"],
  "properties": { "schemaVersion": { "const": 2 }, "sourceId": { "$ref": "#/$defs/id" }, "repository": { "$ref": "#/$defs/httpsUrl" }, "queryUrls": { "$ref": "#/$defs/httpsUrlArray" }, "reportedCountClaims": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/countClaim" } }, "markdownIndexPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "entryKind": { "enum": ["marketplace-entry", "plugin-manifest", "skill-file", "repository-record"] }, "httpsUrl": { "type": "string", "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?::[0-9]+)?(?:/[^\\s]*)?(?:\\?[^\\s#]*)?(?:#[^\\s]*)?$" }, "httpsUrlArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/httpsUrl" } }, "countClaim": { "type": "object", "additionalProperties": false, "required": ["kind", "count", "sourceUrl"], "properties": { "kind": { "$ref": "#/$defs/entryKind" }, "count": { "type": "integer", "minimum": 0 }, "sourceUrl": { "$ref": "#/$defs/httpsUrl" } } } }
}
