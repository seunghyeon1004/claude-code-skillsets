{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/review-source-index.schema.json",
  "title": "ReviewSourceIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "triads"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "triads": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/triad" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "triad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "receiptId", "snapshotId"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "receiptId": { "$ref": "#/$defs/id" },
        "snapshotId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
