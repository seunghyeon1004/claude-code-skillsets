{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/research-queue.schema.json", "title": "ResearchQueue", "type": "object", "additionalProperties": false, "required": ["schemaVersion", "candidates", "capabilitySearch"], "properties": { "schemaVersion": { "const": 2 }, "candidates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/candidate" } }, "capabilitySearch": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/search" } } },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "idArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "emptyOrIdArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "stringArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "httpsRepository": { "type": "string", "pattern": "^https://[^/@?#:]+(?:\\.[^/@?#:]+)+(?:/[^?#]*)?$" }, "dateTime": { "type": "string", "format": "date-time" }, "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.?(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000-\\u001f])[A-Za-z0-9._/-]+$" },
    "target": { "type": "object", "additionalProperties": false, "required": ["runtime", "platform"], "properties": { "runtime": { "enum": ["claude-code", "codex"] }, "platform": { "enum": ["darwin", "linux", "win32"] } } },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["id", "capabilityIds", "snapshotId", "discoverySnapshotId", "discoveryEntryAddress", "searchTerms", "discoverySourceUrl", "observedAt", "candidateRepository", "candidatePath", "originalRepository", "discoveryTier", "provenance", "materiallyDistinctGroup", "targets"], "properties": { "id": { "$ref": "#/$defs/id" }, "capabilityIds": { "$ref": "#/$defs/idArray" }, "snapshotId": { "$ref": "#/$defs/id" }, "discoverySnapshotId": { "$ref": "#/$defs/id" }, "discoveryEntryAddress": { "type": "string", "minLength": 1 }, "searchTerms": { "$ref": "#/$defs/stringArray" }, "discoverySourceUrl": { "$ref": "#/$defs/httpsRepository" }, "observedAt": { "$ref": "#/$defs/dateTime" }, "candidateRepository": { "$ref": "#/$defs/httpsRepository" }, "candidatePath": { "$ref": "#/$defs/relativePath" }, "originalRepository": { "$ref": "#/$defs/httpsRepository" }, "discoveryTier": { "enum": ["A", "B", "C", "D"] }, "provenance": { "enum": ["original", "aggregator-follow-through"] }, "materiallyDistinctGroup": { "type": "string", "minLength": 1 }, "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/target" } } } },
    "search": { "type": "object", "additionalProperties": false, "required": ["id", "capabilityId", "runtime", "platform", "candidateIds", "searchEvidenceIds"], "properties": { "id": { "$ref": "#/$defs/id" }, "capabilityId": { "$ref": "#/$defs/id" }, "runtime": { "enum": ["claude-code", "codex"] }, "platform": { "enum": ["darwin", "linux", "win32"] }, "candidateIds": { "$ref": "#/$defs/emptyOrIdArray" }, "searchEvidenceIds": { "$ref": "#/$defs/emptyOrIdArray" } } }
  }
}
