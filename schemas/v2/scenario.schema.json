{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/scenario.schema.json",
  "title": "CompleteV1ScenarioSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "packId", "caseType", "prompt", "expectedBehaviors", "forbiddenBehaviors"],
  "properties": {
    "id": { "$ref": "#/$defs/kebabCaseId" },
    "packId": { "$ref": "#/$defs/kebabCaseId" },
    "caseType": { "enum": ["normal", "boundary", "refusal"] },
    "prompt": { "type": "string", "minLength": 1 },
    "expectedBehaviors": { "$ref": "#/$defs/nonEmptyStringArray" },
    "forbiddenBehaviors": { "$ref": "#/$defs/nonEmptyStringArray" }
  },
  "$defs": {
    "kebabCaseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
