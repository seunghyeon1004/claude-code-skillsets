{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/research-evidence.schema.json", "title": "ResearchEvidence", "oneOf": [{ "$ref": "#/$defs/static" }, { "$ref": "#/$defs/target" }, { "$ref": "#/$defs/result" }, { "$ref": "#/$defs/highImpact" }, { "$ref": "#/$defs/search" }, { "$ref": "#/$defs/observedMarketplaceIdentity" }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "dateTime": { "type": "string", "format": "date-time" }, "artifactPath": { "type": "string", "pattern": "^research/evidence/artifacts/(?!.*(?:^|/)\\.?(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000-\\u001f])[A-Za-z0-9._/-]+$" },
    "idArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "stringArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "urlArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^https://[^/@?#:]+(?:\\.[^/@?#:]+)+(?:/[^?#]*)?$" } },
    "baseProperties": { "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "reviewId": { "$ref": "#/$defs/id" }, "providerId": { "$ref": "#/$defs/id" }, "snapshotId": { "$ref": "#/$defs/id" }, "reviewedCommit": { "$ref": "#/$defs/sha1" }, "kind": { "type": "string" }, "scope": { "type": "object" }, "observedAt": { "$ref": "#/$defs/dateTime" }, "artifactPath": { "$ref": "#/$defs/artifactPath" }, "artifactSha256": { "$ref": "#/$defs/sha256" }, "outcome": { "enum": ["passed", "failed"] }, "summary": { "type": "string", "minLength": 1 } },
    "nullScope": { "type": "object", "additionalProperties": false, "required": ["runtime", "platform", "capabilityId"], "properties": { "runtime": { "type": "null" }, "platform": { "type": "null" }, "capabilityId": { "type": "null" } } }, "targetScope": { "type": "object", "additionalProperties": false, "required": ["runtime", "platform", "capabilityId"], "properties": { "runtime": { "enum": ["claude-code", "codex"] }, "platform": { "enum": ["darwin", "linux", "win32"] }, "capabilityId": { "type": "null" } } }, "capabilityScope": { "type": "object", "additionalProperties": false, "required": ["runtime", "platform", "capabilityId"], "properties": { "runtime": { "enum": ["claude-code", "codex"] }, "platform": { "enum": ["darwin", "linux", "win32"] }, "capabilityId": { "$ref": "#/$defs/id" } } },
    "static": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "reviewId", "providerId", "snapshotId", "reviewedCommit", "kind", "scope", "observedAt", "artifactPath", "artifactSha256", "outcome", "summary"], "properties": { "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "reviewId": { "$ref": "#/$defs/id" }, "providerId": { "$ref": "#/$defs/id" }, "snapshotId": { "$ref": "#/$defs/id" }, "reviewedCommit": { "$ref": "#/$defs/sha1" }, "kind": { "enum": ["source-identity", "marketplace-identity", "license", "surface-inventory", "permissions", "secret-flow", "maintenance", "documentation"] }, "scope": { "$ref": "#/$defs/nullScope" }, "observedAt": { "$ref": "#/$defs/dateTime" }, "artifactPath": { "$ref": "#/$defs/artifactPath" }, "artifactSha256": { "$ref": "#/$defs/sha256" }, "outcome": { "enum": ["passed", "failed"] }, "summary": { "type": "string", "minLength": 1 } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "reviewId", "providerId", "snapshotId", "reviewedCommit", "kind", "scope", "observedAt", "artifactPath", "artifactSha256", "outcome", "summary"], "properties": { "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "reviewId": { "$ref": "#/$defs/id" }, "providerId": { "$ref": "#/$defs/id" }, "snapshotId": { "$ref": "#/$defs/id" }, "reviewedCommit": { "$ref": "#/$defs/sha1" }, "kind": { "enum": ["compatibility", "install-smoke", "update-smoke", "remove-smoke", "doctor-smoke", "lifecycle"] }, "scope": { "$ref": "#/$defs/targetScope" }, "observedAt": { "$ref": "#/$defs/dateTime" }, "artifactPath": { "$ref": "#/$defs/artifactPath" }, "artifactSha256": { "$ref": "#/$defs/sha256" }, "outcome": { "enum": ["passed", "failed"] }, "summary": { "type": "string", "minLength": 1 } } },
    "result": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "reviewId", "providerId", "snapshotId", "reviewedCommit", "kind", "scope", "caseId", "caseClass", "observedAt", "artifactPath", "artifactSha256", "outcome", "summary"], "properties": { "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "reviewId": { "$ref": "#/$defs/id" }, "providerId": { "$ref": "#/$defs/id" }, "snapshotId": { "$ref": "#/$defs/id" }, "reviewedCommit": { "$ref": "#/$defs/sha1" }, "kind": { "enum": ["outcome-evaluation", "semantic-smoke"] }, "scope": { "$ref": "#/$defs/capabilityScope" }, "caseId": { "$ref": "#/$defs/id" }, "caseClass": { "enum": ["normal", "boundary", "refusal"] }, "observedAt": { "$ref": "#/$defs/dateTime" }, "artifactPath": { "$ref": "#/$defs/artifactPath" }, "artifactSha256": { "$ref": "#/$defs/sha256" }, "outcome": { "enum": ["passed", "failed"] }, "summary": { "type": "string", "minLength": 1 } } },
    "highImpact": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "reviewId", "providerId", "snapshotId", "reviewedCommit", "kind", "scope", "reviewedArtifactSha256s", "reviewerId", "collectorId", "upstreamAuthorIds", "independenceAttestation", "normalResultEvidenceIds", "boundaryResultEvidenceIds", "refusalResultEvidenceIds", "decision", "observedAt", "artifactPath", "artifactSha256", "outcome", "summary"], "properties": { "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "reviewId": { "$ref": "#/$defs/id" }, "providerId": { "$ref": "#/$defs/id" }, "snapshotId": { "$ref": "#/$defs/id" }, "reviewedCommit": { "$ref": "#/$defs/sha1" }, "kind": { "const": "high-impact-review" }, "scope": { "$ref": "#/$defs/capabilityScope" }, "reviewedArtifactSha256s": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }, "reviewerId": { "$ref": "#/$defs/id" }, "collectorId": { "$ref": "#/$defs/id" }, "upstreamAuthorIds": { "$ref": "#/$defs/idArray" }, "independenceAttestation": { "type": "string", "minLength": 1 }, "normalResultEvidenceIds": { "$ref": "#/$defs/idArray" }, "boundaryResultEvidenceIds": { "$ref": "#/$defs/idArray" }, "refusalResultEvidenceIds": { "$ref": "#/$defs/idArray" }, "decision": { "const": "approved" }, "observedAt": { "$ref": "#/$defs/dateTime" }, "artifactPath": { "$ref": "#/$defs/artifactPath" }, "artifactSha256": { "$ref": "#/$defs/sha256" }, "outcome": { "enum": ["passed", "failed"] }, "summary": { "type": "string", "minLength": 1 } } },
    "search": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "kind", "searchRecordId", "capabilityId", "runtime", "platform", "queryTerms", "sourceUrls", "snapshotIds", "observedAt", "artifactPath", "artifactSha256", "outcome", "summary"], "properties": { "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "kind": { "const": "search-evidence" }, "searchRecordId": { "$ref": "#/$defs/id" }, "capabilityId": { "$ref": "#/$defs/id" }, "runtime": { "enum": ["claude-code", "codex"] }, "platform": { "enum": ["darwin", "linux", "win32"] }, "queryTerms": { "$ref": "#/$defs/stringArray" }, "sourceUrls": { "$ref": "#/$defs/urlArray" }, "snapshotIds": { "$ref": "#/$defs/idArray" }, "observedAt": { "$ref": "#/$defs/dateTime" }, "artifactPath": { "$ref": "#/$defs/artifactPath" }, "artifactSha256": { "$ref": "#/$defs/sha256" }, "outcome": { "enum": ["passed", "failed"] }, "summary": { "type": "string", "minLength": 1 } } },
    "observedMarketplaceIdentity": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "reviewId", "providerId", "kind", "observationEvidenceId", "reviewedCommit", "observedArtifactPath", "observedArtifactSha256", "scope", "observedAt", "artifactPath", "artifactSha256", "outcome", "summary"], "properties": { "schemaVersion": { "const": 3 }, "id": { "$ref": "#/$defs/id" }, "reviewId": { "$ref": "#/$defs/id" }, "providerId": { "$ref": "#/$defs/id" }, "kind": { "const": "marketplace-identity" }, "observationEvidenceId": { "$ref": "#/$defs/id" }, "reviewedCommit": { "$ref": "#/$defs/sha1" }, "observedArtifactPath": { "type": "string", "pattern": "^research/marketplaces/[a-z0-9][a-z0-9-]*\\.json$" }, "observedArtifactSha256": { "$ref": "#/$defs/sha256" }, "scope": { "$ref": "#/$defs/nullScope" }, "observedAt": { "$ref": "#/$defs/dateTime" }, "artifactPath": { "$ref": "#/$defs/artifactPath" }, "artifactSha256": { "$ref": "#/$defs/sha256" }, "outcome": { "enum": ["passed", "failed"] }, "summary": { "type": "string", "minLength": 1 } } }
  }
}
