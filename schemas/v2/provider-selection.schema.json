{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/provider-selection.schema.json", "title": "ProviderSelectionManifest", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "capabilityId", "runtime", "platform", "searchRecordId", "disposition", "alternateProviderIds", "terminalReviewIds", "decisionReasons", "releaseEvidence"],
  "properties": { "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "capabilityId": { "$ref": "#/$defs/id" }, "runtime": { "enum": ["claude-code", "codex"] }, "platform": { "enum": ["darwin", "linux", "win32"] }, "searchRecordId": { "$ref": "#/$defs/id" }, "disposition": { "enum": ["selected", "alternate", "rejected", "unavailable"] }, "preferredProviderId": { "$ref": "#/$defs/id" }, "alternateProviderIds": { "$ref": "#/$defs/idList" }, "terminalReviewIds": { "$ref": "#/$defs/idList" }, "decisionReasons": { "$ref": "#/$defs/textList" }, "releaseEvidence": { "enum": ["trialed-p04", "not-applicable"] } },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "textList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
}
