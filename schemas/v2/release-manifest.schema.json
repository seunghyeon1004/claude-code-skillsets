{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/release-manifest.schema.json",
  "title": "ReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateCommit", "catalogFingerprint", "repositoryVisibility", "evidence", "criticalFindings", "importantFindings"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "candidateCommit": { "$ref": "#/$defs/sha1" },
    "catalogFingerprint": { "$ref": "#/$defs/sha256" },
    "repositoryVisibility": { "const": "PUBLIC" },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceRow" },
      "allOf": [
        { "contains": { "type": "object", "required": ["platform"], "properties": { "platform": { "const": "darwin" } } } },
        { "contains": { "type": "object", "required": ["platform"], "properties": { "platform": { "const": "linux" } } } },
        { "contains": { "type": "object", "required": ["platform"], "properties": { "platform": { "const": "win32" } } } }
      ]
    },
    "criticalFindings": { "type": "integer", "minimum": 0 },
    "importantFindings": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "kebabCaseId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidenceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/kebabCaseId" },
        "platform": { "enum": ["darwin", "linux", "win32", "cross-platform"] },
        "status": { "enum": ["proven", "missing", "contradicted"] },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "workflowRunId": { "$ref": "#/$defs/kebabCaseId" }
      }
    }
  }
}
