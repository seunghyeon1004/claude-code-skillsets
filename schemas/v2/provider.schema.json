{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/provider.schema.json",
  "title": "ProviderManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "capabilityIds", "sourceReviewId", "permissions", "version", "status", "trustTier", "runtimeContracts"],
  "properties": {
    "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "capabilityIds": { "$ref": "#/$defs/idArray" }, "sourceReviewId": { "$ref": "#/$defs/id" },
    "permissions": { "$ref": "#/$defs/permissions" }, "version": { "$ref": "#/$defs/semver" }, "status": { "enum": ["draft", "stable", "deprecated", "blocked"] }, "trustTier": { "enum": ["trusted", "community", "blocked"] },
    "runtimeContracts": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "oneOf": [{ "$ref": "#/$defs/nativePlugin" }, { "$ref": "#/$defs/agentSkill" }] } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "commandId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "idArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "platformArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["darwin", "linux", "win32"] } },
    "httpsRepository": { "type": "string", "pattern": "^https://[^/@?#:]+(?:\\.[^/@?#:]+)+(?:/[^?#]*)?$" }, "relativePath": { "type": "string", "pattern": "^(?!-)(?!/)(?!.*(?:^|/)\\.?(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000-\\u001f])[A-Za-z0-9._/-]+$" },
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "permissions": { "type": "object", "additionalProperties": false, "required": ["filesystem", "commands", "network", "externalData"], "properties": { "filesystem": { "$ref": "#/$defs/stringArray" }, "commands": { "$ref": "#/$defs/stringArray" }, "network": { "$ref": "#/$defs/stringArray" }, "externalData": { "$ref": "#/$defs/stringArray" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/relativePath" }, "sha256": { "$ref": "#/$defs/sha256" } } }, "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact" } },
    "runtimeBase": { "type": "object", "required": ["runtime", "packaging", "runtimeVersionRange", "platforms", "reviewedCommit", "artifacts"], "properties": { "runtime": { "enum": ["claude-code", "codex"] }, "packaging": { "type": "string" }, "runtimeVersionRange": { "type": "string", "minLength": 1 }, "platforms": { "$ref": "#/$defs/platformArray" }, "reviewedCommit": { "$ref": "#/$defs/sha1" }, "artifacts": { "$ref": "#/$defs/artifacts" } } },
    "nativePlugin": { "allOf": [{ "$ref": "#/$defs/runtimeBase" }, { "type": "object", "additionalProperties": false, "required": ["runtime", "packaging", "runtimeVersionRange", "platforms", "marketplaceId", "marketplaceSource", "pluginId", "reviewedCommit", "artifacts"], "properties": { "runtime": { "enum": ["claude-code", "codex"] }, "packaging": { "const": "native-plugin" }, "runtimeVersionRange": { "type": "string", "minLength": 1 }, "platforms": { "$ref": "#/$defs/platformArray" }, "marketplaceId": { "$ref": "#/$defs/commandId" }, "marketplaceSource": { "$ref": "#/$defs/httpsRepository" }, "pluginId": { "$ref": "#/$defs/commandId" }, "reviewedCommit": { "$ref": "#/$defs/sha1" }, "artifacts": { "$ref": "#/$defs/artifacts" } } }] },
    "agentSkill": { "allOf": [{ "$ref": "#/$defs/runtimeBase" }, { "type": "object", "additionalProperties": false, "required": ["runtime", "packaging", "runtimeVersionRange", "platforms", "repositoryUrl", "subdirectory", "ref", "reviewedCommit", "artifacts"], "properties": { "runtime": { "enum": ["claude-code", "codex"] }, "packaging": { "const": "agent-skill" }, "runtimeVersionRange": { "type": "string", "minLength": 1 }, "platforms": { "$ref": "#/$defs/platformArray" }, "repositoryUrl": { "$ref": "#/$defs/httpsRepository" }, "subdirectory": { "$ref": "#/$defs/relativePath" }, "ref": { "type": "string", "minLength": 1 }, "reviewedCommit": { "$ref": "#/$defs/sha1" }, "artifacts": { "$ref": "#/$defs/artifacts" } } }] }
  }
}
