{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v2/research-collection-receipt.schema.json",
  "title": "ResearchCollectionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "sourceId", "snapshotId", "observedAt", "inspectedCommit", "collectorVersion", "independentCounts", "snapshotContentSha256"],
  "properties": { "schemaVersion": { "const": 2 }, "id": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" }, "snapshotId": { "$ref": "#/$defs/id" }, "observedAt": { "$ref": "#/$defs/dateTime" }, "inspectedCommit": { "$ref": "#/$defs/sha1" }, "collectorVersion": { "$ref": "#/$defs/semver" }, "independentCounts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/count" } }, "snapshotContentSha256": { "$ref": "#/$defs/sha256" } },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "entryKind": { "enum": ["marketplace-entry", "plugin-manifest", "skill-file", "repository-record"] }, "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "dateTime": { "type": "string", "pattern": "^(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$" }, "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$" }, "count": { "type": "object", "additionalProperties": false, "required": ["kind", "count"], "properties": { "kind": { "$ref": "#/$defs/entryKind" }, "count": { "type": "integer", "minimum": 0 } } } }
}
