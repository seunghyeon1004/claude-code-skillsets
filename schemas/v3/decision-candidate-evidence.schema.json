{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v3/decision-candidate-evidence.schema.json",
  "title": "DecisionCandidateEvidenceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidates", "evidence"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/baseCandidate" }
    },
    "candidateRevisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateRevision" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "officialTargetCompatibilityEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/officialTargetCompatibilityEvidence" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fieldEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contentSha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "contentSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "sensitiveString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["observed", "unknown", "not-applicable"] },
        "value": { "type": "string" },
        "evidence": { "$ref": "#/$defs/fieldEvidence" }
      }
    },
    "sensitiveStringArray": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["observed", "unknown", "not-applicable"] },
        "value": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": { "$ref": "#/$defs/fieldEvidence" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "skillPath",
        "runtime",
        "state",
        "stateReasons",
        "providedCapabilityIds",
        "capabilityEvidenceIds",
        "revisionBinding",
        "permissions",
        "license",
        "trust",
        "dependencies"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "candidateRevisionId": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "sourceId": { "$ref": "#/$defs/id" },
        "skillPath": { "type": ["string", "null"], "minLength": 1 },
        "runtime": { "enum": ["claude-code", "codex"] },
        "state": { "enum": ["eligible-with-disclosures", "held", "blocked"] },
        "stateReasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "providedCapabilityIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "capabilityEvidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "revisionBinding": { "enum": ["exact", "unavailable"] },
        "permissions": { "$ref": "#/$defs/sensitiveStringArray" },
        "license": { "$ref": "#/$defs/sensitiveString" },
        "trust": { "$ref": "#/$defs/sensitiveString" },
        "dependencies": { "$ref": "#/$defs/sensitiveStringArray" },
        "officialBaseline": { "$ref": "#/$defs/officialMarketplaceBaseline" },
        "codexInstall": { "$ref": "#/$defs/codexInstall" }
      }
    },
    "baseCandidate": {
      "allOf": [
        { "$ref": "#/$defs/candidate" },
        { "type": "object", "properties": { "candidateRevisionId": false } }
      ]
    },
    "candidateRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "candidateId", "previousRevisionId", "candidate", "approval"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "candidateId": { "$ref": "#/$defs/id" },
        "previousRevisionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "candidate": { "$ref": "#/$defs/candidate" },
        "approval": { "$ref": "#/$defs/candidateRevisionApproval" }
      }
    },
    "candidateRevisionApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "disposition",
        "reviewerId",
        "reviewedAt",
        "sourceCommit",
        "marketplaceManifestSha256",
        "candidateIdentity",
        "observedArtifactPath",
        "observedArtifactSha256",
        "observationEvidenceId",
        "evidenceArtifactPath",
        "evidenceArtifactSha256",
        "evidenceIds",
        "digest"
      ],
      "properties": {
        "kind": { "const": "exact-candidate-rebind" },
        "disposition": { "enum": ["eligible-with-disclosures", "held", "blocked"] },
        "reviewerId": { "$ref": "#/$defs/id" },
        "reviewedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "marketplaceManifestSha256": { "$ref": "#/$defs/sha256" },
        "candidateIdentity": { "type": "string", "minLength": 1 },
        "observedArtifactPath": {
          "type": "string",
          "pattern": "^research/marketplaces/[a-z0-9][a-z0-9-]*\\.json$"
        },
        "observedArtifactSha256": { "$ref": "#/$defs/sha256" },
        "observationEvidenceId": { "$ref": "#/$defs/id" },
        "evidenceArtifactPath": {
          "type": "string",
          "pattern": "^research/evidence/artifacts/[^\\\\/]+(?:/[^\\\\/]+)*\\.json$"
        },
        "evidenceArtifactSha256": { "$ref": "#/$defs/sha256" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "officialMarketplaceBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "marketplaceManifestSha256", "pluginName", "sourceUrl", "sourceCommit", "sourceBlobs"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "marketplaceManifestSha256": { "$ref": "#/$defs/sha256" },
        "pluginName": { "$ref": "#/$defs/id" },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceBlobs": { "$ref": "#/$defs/immutableSourceBlobs" }
      }
    },
    "immutableSourceBlobs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "immutableRawUrl", "contentSha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "immutableRawUrl": { "type": "string", "pattern": "^https://raw\\.githubusercontent\\.com/" },
          "contentSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "codexInstall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "skillPath", "reviewDecisionId", "compatibilityEvidence", "targetPlatform"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "skillPath": { "type": "string", "minLength": 1 },
        "reviewDecisionId": { "type": "string", "minLength": 1 },
        "compatibilityEvidence": { "type": "string", "minLength": 1 },
        "targetPlatform": { "enum": ["darwin", "linux", "win32"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidateId",
        "capabilityId",
        "kind",
        "current",
        "reference",
        "contentSha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "candidateId": { "$ref": "#/$defs/id" },
        "candidateRevisionId": { "$ref": "#/$defs/id" },
        "capabilityId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["official-baseline", "official-listing", "observation"] },
        "current": { "type": "boolean" },
        "reference": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "artifactPath": { "type": "string", "pattern": "^research/evidence/artifacts/[^\\\\/]+(?:/[^\\\\/]+)*\\.json$" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "support": { "enum": ["direct", "inferred", "related"] },
        "sourceBlobs": { "$ref": "#/$defs/immutableSourceBlobs" },
        "listingExcerpt": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "listingExcerptSha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [{
        "if": {
          "type": "object",
          "properties": { "kind": { "const": "official-listing" } },
          "required": ["kind"]
        },
        "then": {
          "type": "object",
          "required": ["support", "listingExcerpt", "listingExcerptSha256"],
          "properties": {
            "support": true,
            "listingExcerpt": true,
            "listingExcerptSha256": true,
            "artifactPath": false,
            "artifactSha256": false,
            "sourceBlobs": false
          }
        },
        "else": {
          "type": "object",
          "properties": {
            "support": { "enum": ["direct", "inferred"] },
            "listingExcerpt": false,
            "listingExcerptSha256": false
          }
        }
      }]
    },
    "officialTargetCompatibilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidateId",
        "sourceId",
        "runtime",
        "platform",
        "compatibility",
        "kind",
        "observedAt",
        "reviewedAt",
        "expiresAt",
        "snapshot",
        "sourceUrls",
        "disclosures",
        "evidenceDigest"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "candidateId": { "$ref": "#/$defs/id" },
        "candidateRevisionId": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "runtime": { "enum": ["claude-code", "codex"] },
        "platform": { "enum": ["darwin", "linux", "win32"] },
        "compatibility": { "const": "verified" },
        "kind": { "const": "official-source-bound-inference" },
        "observedAt": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "minLength": 1 },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sourceUrl",
            "marketplaceEntryUrl",
            "marketplaceEntrySourceUrl",
            "marketplaceEntrySourceCommit",
            "digest"
          ],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "sourceUrl": { "type": "string", "pattern": "^https://" },
            "marketplaceEntryUrl": { "type": "string", "pattern": "^https://" },
            "marketplaceEntrySourceUrl": { "type": "string", "pattern": "^https://" },
            "marketplaceEntrySourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "sourceUrls": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https://" }
        },
        "disclosures": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
