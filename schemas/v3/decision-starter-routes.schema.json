{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v3/decision-starter-routes.schema.json",
  "title": "DecisionStarterRoutesManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainId",
        "kind",
        "orderedCandidateIds",
        "smallestHonestProfile",
        "directEvidenceIds",
        "inferredEvidenceIds",
        "unsupportedCapabilityIds",
        "broadCoverageComplete"
      ],
      "properties": {
        "domainId": { "$ref": "#/$defs/id" },
        "kind": { "const": "starter-partial" },
        "orderedCandidateIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "smallestHonestProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ko", "en"],
          "properties": {
            "ko": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          }
        },
        "directEvidenceIds": { "$ref": "#/$defs/idList" },
        "inferredEvidenceIds": { "$ref": "#/$defs/idList" },
        "relatedEvidenceIds": { "$ref": "#/$defs/idList" },
        "unsupportedCapabilityIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "broadCoverageComplete": { "const": false }
      }
    }
  }
}
