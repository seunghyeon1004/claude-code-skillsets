{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/v3/decision-intents.schema.json",
  "title": "DecisionIntentsManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "profiles": { "type": "array", "minItems": 20, "maxItems": 20, "items": { "$ref": "#/$defs/profile" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domainId", "phrases", "coreCapabilityId", "requiredCapabilityIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "domainId": { "$ref": "#/$defs/id" },
        "phrases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ko", "en"],
          "properties": {
            "ko": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "en": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "coreCapabilityId": { "$ref": "#/$defs/id" },
        "requiredCapabilityIds": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
