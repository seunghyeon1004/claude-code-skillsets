{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/pack.schema.json",
  "title": "PackManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "categories",
    "outcome",
    "targetUsers",
    "whenToUse",
    "whenNotToUse",
    "inputs",
    "outputs",
    "workflow",
    "requiredPlugins",
    "recommendedPlugins",
    "optionalPlugins",
    "tools",
    "languages",
    "regions",
    "riskLevel",
    "trustRequirements",
    "licenses",
    "evaluationCases",
    "maintainers",
    "version",
    "status"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/kebabCaseId" },
    "domain": { "$ref": "#/$defs/kebabCaseId" },
    "categories": { "$ref": "#/$defs/nonEmptyStringArray" },
    "outcome": { "$ref": "#/$defs/localizedText" },
    "targetUsers": { "$ref": "#/$defs/stringArray" },
    "whenToUse": { "$ref": "#/$defs/stringArray" },
    "whenNotToUse": { "$ref": "#/$defs/stringArray" },
    "inputs": { "$ref": "#/$defs/nonEmptyStringArray" },
    "outputs": { "$ref": "#/$defs/nonEmptyStringArray" },
    "workflow": { "$ref": "#/$defs/stringArray" },
    "requiredPlugins": { "$ref": "#/$defs/stringArray" },
    "recommendedPlugins": { "$ref": "#/$defs/stringArray" },
    "optionalPlugins": { "$ref": "#/$defs/stringArray" },
    "tools": { "$ref": "#/$defs/stringArray" },
    "requiredExecutables": { "$ref": "#/$defs/executableArray" },
    "optionalExecutables": { "$ref": "#/$defs/executableArray" },
    "languages": { "$ref": "#/$defs/nonEmptyStringArray" },
    "regions": { "$ref": "#/$defs/stringArray" },
    "riskLevel": { "$ref": "#/$defs/riskLevel" },
    "trustRequirements": { "$ref": "#/$defs/trustTier" },
    "licenses": { "$ref": "#/$defs/nonEmptyStringArray" },
    "evaluationCases": { "$ref": "#/$defs/nonEmptyStringArray" },
    "maintainers": { "$ref": "#/$defs/nonEmptyStringArray" },
    "version": { "$ref": "#/$defs/semver" },
    "status": { "$ref": "#/$defs/releaseStatus" }
  },
  "$defs": {
    "kebabCaseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "executableArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
      },
      "uniqueItems": true
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "trustTier": {
      "type": "string",
      "enum": ["verified", "trusted", "community"]
    },
    "riskLevel": {
      "type": "string",
      "enum": ["standard", "review-required", "expert-required"]
    },
    "releaseStatus": {
      "type": "string",
      "enum": ["draft", "beta", "stable", "deprecated", "blocked"]
    }
  }
}
