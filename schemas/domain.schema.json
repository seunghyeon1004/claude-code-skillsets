{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyeon1004/claude-code-skillsets/schemas/domain.schema.json",
  "title": "DomainManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "categories",
    "languages",
    "regions",
    "maintainers",
    "version",
    "status"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/kebabCaseId" },
    "name": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "categories": { "$ref": "#/$defs/nonEmptyStringArray" },
    "languages": { "$ref": "#/$defs/nonEmptyStringArray" },
    "regions": { "$ref": "#/$defs/stringArray" },
    "maintainers": { "$ref": "#/$defs/nonEmptyStringArray" },
    "version": { "$ref": "#/$defs/semver" },
    "status": { "$ref": "#/$defs/releaseStatus" }
  },
  "$defs": {
    "kebabCaseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "releaseStatus": {
      "type": "string",
      "enum": ["draft", "beta", "stable", "deprecated", "blocked"]
    }
  }
}
